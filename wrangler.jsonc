{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flowtree",
  "account_id": "7c226e7fdc20b6b59deaab2d75690571",
  "vars": {
    "APP_ORIGIN": "https://flowtree.flowtreeapp.workers.dev",
    "GOOGLE_CLIENT_ID": "739360473101-mi3ql0icmce2vr7jgttmdgoivse8s6ao.apps.googleusercontent.com"
  },
  "main": "server/worker.js",
  "compatibility_date": "2026-10-30",
  "build": { "command": "npm run build:server" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/auth/*", "/api/*"]
  },
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "SessionStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionStore"] }],
  "ratelimits": [{ "name": "AUTH_RATE_LIMIT", "namespace_id": "479001", "simple": { "limit": 30, "period": 60 } }],
  "observability": { "enabled": false }
}
